{% css %}{% include "components/Projects.css" %}{% endcss %}
<section class="projects" aria-labelledby="projects">
  <header>
    <h2 id="projects">Projecten</h2>
  </header>
  <ul>
    {% for project in projects %}
      <li>
        <img
          src="{{ project.image }}"
          alt="{{ project.title }}"
          width="1200"
          height="900"
        />
        <h3>{{ project.title }}</h3>
        {% if project.description %}
          <p class="description">{{ project.description }}</p>
        {% endif %}
        {% if project.tags %}
          <ul class="tags">
            {% for tag in project.tags %}
              <li>{{ tag }}</li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if project.slug %}
          <footer>
            <a href="{{ project.slug }}">Bekijk project →</a>
          </footer>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</section>
